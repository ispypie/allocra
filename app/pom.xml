<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.allocra</groupId>
    <artifactId>allocra-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>app</artifactId>
  <name>Allocra :: app</name>
  <description>Spring Boot bootstrap and wiring. Depends on all modules; nothing depends on app.</description>

  <dependencies>
    <!-- Web + operations -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Persistence + migrations (ADR-002, ADR-004, ADR-008) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- All modules are wired here (wiring only; nothing depends on app) -->
    <dependency><groupId>com.allocra</groupId><artifactId>common</artifactId></dependency>
    <dependency><groupId>com.allocra</groupId><artifactId>identity</artifactId></dependency>
    <dependency><groupId>com.allocra</groupId><artifactId>tenancy</artifactId></dependency>
    <dependency><groupId>com.allocra</groupId><artifactId>membership</artifactId></dependency>
    <dependency><groupId>com.allocra</groupId><artifactId>resources</artifactId></dependency>
    <dependency><groupId>com.allocra</groupId><artifactId>services</artifactId></dependency>
    <dependency><groupId>com.allocra</groupId><artifactId>availability</artifactId></dependency>
    <dependency><groupId>com.allocra</groupId><artifactId>scheduling</artifactId></dependency>
    <dependency><groupId>com.allocra</groupId><artifactId>bookings</artifactId></dependency>
    <dependency><groupId>com.allocra</groupId><artifactId>reservations</artifactId></dependency>
    <dependency><groupId>com.allocra</groupId><artifactId>audit</artifactId></dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Activates the failsafe executions declared in the parent pluginManagement (*IT tests) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
